+bool DX11::bridgeAlive()
+{
+	ssb_video* v = SsbBridge::video();
+	if (!v) return false;
+	const DWORD now = GetTickCount();
+	const uint32_t hb = v->heartbeat;
+	if (hb != _bridgeHb || _bridgeHbTick == 0) {
+		_bridgeHb = hb;
+		_bridgeHbTick = now;
+		return true;
+	}
+	return (now - _bridgeHbTick) < 2000;
+}
+
+bool DX11::captureScreenBridge(ParsecDSO* ps)
+{
+	ssb_video* v = SsbBridge::video();
+	if (!v || !_device || !_context) return false;
+
+	// Wait for the next frame: the media loop is paced by the screen, one submit per new frame. After
+	// 40 ms without one (static desktop) the last frame is submitted again as a keep-alive.
+	int defaultHz = (int)Config::cfg.video.fps; if (defaultHz < 10 || defaultHz > 240) defaultHz = 60;
+	const int paceHz = SsbBridge::tuningInt("submit_pace_hz", defaultHz);   // steady-clock submission; 0 = per arrival
+	if (paceHz > 0) {
+		LARGE_INTEGER qf, qn; QueryPerformanceFrequency(&qf);
+		static double next = 0;
+		auto nowMs = [&]() { QueryPerformanceCounter(&qn); return qn.QuadPart * 1000.0 / qf.QuadPart; };
+		const double interval = 1000.0 / paceHz;
+		double now = nowMs();
+		if (next == 0 || next < now - 100) next = now;
+		next += interval;
+		// High-resolution waitable timer: sleeps precisely without busy-spinning (matters at 200+ Hz).
+		static HANDLE hrTimer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002 /*CREATE_WAITABLE_TIMER_HIGH_RESOLUTION*/, TIMER_ALL_ACCESS);
+		for (double rem = next - nowMs(); rem > 0; rem = next - nowMs()) {
+			if (hrTimer) {
+				LARGE_INTEGER due; due.QuadPart = -(LONGLONG)(rem * 10000.0);   // relative, 100 ns units
+				SetWaitableTimer(hrTimer, &due, 0, nullptr, nullptr, FALSE);
+				WaitForSingleObject(hrTimer, 50);
+			}
+			else {
+				Sleep(rem > 2.0 ? (DWORD)(rem - 1.0) : 0);
+			}
+		}
+	} else {
+		const int submitHz = SsbBridge::tuningInt("submit_hz", 0);      // 0 = follow the screen, keep-alive after 40 ms
+		const DWORD maxWait = submitHz > 0 ? (DWORD)(1000 / submitHz > 0 ? 1000 / submitHz : 1) : 40;
+		const DWORD t0 = GetTickCount();
+		while (v->latest == _bridgeSeq && (GetTickCount() - t0) < maxWait)
+			Sleep(1);
+	}
+
+	LARGE_INTEGER workStart; QueryPerformanceCounter(&workStart);
+	// FPS is a cap, not a rate: with a steady clock above the content's own frame rate the tick must not
+	// resubmit identical frames (that would only burn encoder time). Repeat the last frame only as a keep-alive.
+	if (paceHz > 0 && v->latest == _bridgeSeq && _bridgeTexture) {
+		static double lastSubmitMs2 = 0;
+		LARGE_INTEGER qf2, qn2; QueryPerformanceFrequency(&qf2); QueryPerformanceCounter(&qn2);
+		const double nowMs2 = qn2.QuadPart * 1000.0 / qf2.QuadPart;
+		if (_bridgeLastSubmitMs > 0 && nowMs2 - _bridgeLastSubmitMs < 100.0) return true;   // nothing new: stay quiet
+	}
+
+	_mutex.lock();
+
+	const uint32_t latest = v->latest;
+	bool newFrameThisCall = false;
+	if (latest != _bridgeSeq) {
+		_bridgeStatNew += (latest > _bridgeSeq ? latest - _bridgeSeq : 1);
+		if (_bridgeSeq != 0 && latest > _bridgeSeq + 1) {
+			_bridgeStatSkipped += latest - _bridgeSeq - 1;   // source produced frames we never picked up
+			static int skipLogs = 0;
+			if (latest - _bridgeSeq > 3 && skipLogs++ < 10) SsbBridge::log("STALL: capture loop skipped %u source frames", latest - _bridgeSeq - 1);
+		}
+	} else _bridgeStatDup++;
+	{
+		const DWORD now = GetTickCount();
+		if (_bridgeStatTick == 0) _bridgeStatTick = now;
+		if (now - _bridgeStatTick >= 5000) {
+			SsbBridge::log("video: submit spacing ms [<8 | 8-14 | 14-16 | 16-17.5 | 17.5-20 | 20-30 | 30-50 | >50] = [%u | %u | %u | %u | %u | %u | %u | %u]",
+				_bridgeHist[0], _bridgeHist[1], _bridgeHist[2], _bridgeHist[3], _bridgeHist[4], _bridgeHist[5], _bridgeHist[6], _bridgeHist[7]);
+			memset(_bridgeHist, 0, sizeof _bridgeHist);
+			SsbBridge::log("video: %.1f new frames/s, %.1f repeated/s, %llu source frames skipped (source fps %u), slowest submit %.1f ms",
+				_bridgeStatNew * 1000.0 / (now - _bridgeStatTick), _bridgeStatDup * 1000.0 / (now - _bridgeStatTick),
+				(unsigned long long)_bridgeStatSkipped, (unsigned)v->fps, _bridgeSlowest);
+			_bridgeStatNew = _bridgeStatDup = _bridgeStatSkipped = 0; _bridgeStatTick = now; _bridgeSlowest = 0;
+		}
+	}
+	if (latest < _bridgeSeq) _bridgeSeq = 0; // helper restarted a session: frame numbering started over
+	if (latest != 0 && latest != _bridgeSeq)
+	{
+		if (_bridgeSeq == 0)
+			SsbBridge::log("video: first frame from the Linux screen (%ux%u)", (unsigned)v->info[latest % SSB_VIDEO_SLOTS].width, (unsigned)v->info[latest % SSB_VIDEO_SLOTS].height);
+		const uint32_t slot = latest % SSB_VIDEO_SLOTS;
+		const UINT w = v->info[slot].width, h = v->info[slot].height;
+		if (w == 0 || h == 0 || w > SSB_VIDEO_MAX_W || h > SSB_VIDEO_MAX_H)
+		{
+			_mutex.unlock();
+			return false;
+		}
+
+		if (!_bridgeTexture || _bridgeW != w || _bridgeH != h)
+		{
+			SAFE_RELEASE(_bridgeTexture);
+			D3D11_TEXTURE2D_DESC td = {};
+			td.Width = w; td.Height = h;
+			td.MipLevels = 1; td.ArraySize = 1;
+			td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+			td.SampleDesc.Count = 1;
+			td.Usage = D3D11_USAGE_DEFAULT;
+			td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+			if (FAILED(_device->CreateTexture2D(&td, nullptr, &_bridgeTexture)))
+			{
+				_mutex.unlock();
+				return false;
+			}
+			_bridgeW = w; _bridgeH = h;
+			_bridgeTextureValid = false;
+		}
+
+		const ssb_gpu* gpu = reinterpret_cast<const ssb_gpu*>(reinterpret_cast<const uint8_t*>(v) + SSB_GPU_OFFSET);
+		if (gpu->enabled) {
+			// GPU mode: the frame lives in CUDA memory shared by the Linux helper and goes straight to the encoder.
+			// There are no pixels here to upload - the texture only has to exist so Parsec has something to submit.
+			_bridgePixels = nullptr;
+			_bridgeTextureValid = true;
+		}
+		else {
+		const uint8_t* pixels = reinterpret_cast<const uint8_t*>(v) + SSB_VIDEO_HDR_BYTES + (uint64_t)slot * SSB_VIDEO_SLOT_BYTES;
+		// Once the NVENC layer encodes straight from its own pre-uploaded copy, the texture's contents are no
+		// longer read, so skip the 11 MB CPU->GPU upload except for an occasional refresh (and whenever the
+		// fast path is not healthy, so a fallback never encodes a stale frame).
+		static unsigned uploadCounter = 0;
+		const bool skipUpload = _fastPathActive && _bridgeTextureValid && (++uploadCounter % 30) != 0;
+		if (!skipUpload) {
+			_context->UpdateSubresource(_bridgeTexture, 0, nullptr, pixels, w * 4, 0);
+			_bridgeTextureValid = true;
+		}
+		_bridgePixels = pixels;
+		}
+		newFrameThisCall = true;
+		_bridgeSeq = latest;
+
+		_desc.Width = w;
+		_desc.Height = h;
+		_desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+	}
+
+	ID3D11Texture2D* frameToSubmit = _bridgeTexture;
+	if (!frameToSubmit)
+	{
+		_mutex.unlock();
+		return false;
+	}
+
+	// No new frame: the previous one is still in _bridgeTexture and is resubmitted to keep pacing.
+	if (isScalingEnabled())
+	{
+		ID3D11Texture2D* scaled = scaleTexture(_bridgeTexture);
+		if (scaled) frameToSubmit = scaled;
+	}
+
+	D3D11_TEXTURE2D_DESC submitDesc;
+	frameToSubmit->GetDesc(&submitDesc);
+	{
+		// Hooks into our nvEncodeAPI64.dll (looked up by full path - Proton's own library has the same file name).
+		typedef void (WINAPI *PFN_Note)();
+		typedef void (WINAPI *PFN_Offer)(const void*, uint32_t, uint32_t, void*);
+		static PFN_Note note = nullptr; static PFN_Offer offer = nullptr; static bool looked = false;
+		typedef int (WINAPI *PFN_Active)();
+		static PFN_Active active = nullptr;
+		if (!looked) {
+			char path[MAX_PATH]; GetModuleFileNameA(nullptr, path, MAX_PATH);
+			char* slash = strrchr(path, '\\'); if (slash) *slash = 0;
+			HMODULE m = GetModuleHandleA((std::string(path) + "\\nvEncodeAPI64.dll").c_str());
+			if (m) {
+				note = (PFN_Note)GetProcAddress(m, "SsbNoteSubmit");
+				offer = (PFN_Offer)GetProcAddress(m, "SsbOfferFrame");
+				active = (PFN_Active)GetProcAddress(m, "SsbFastPathActive");
+				looked = true;
+				SsbBridge::log("video: NVENC layer found (frame pre-upload %s)", offer ? "available" : "missing");
+			}
+		}
+		if (note) note();
+		_fastPathActive = active && active() != 0;
+		{
+			LARGE_INTEGER qf, qn; QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&qn);
+			const double ms = qn.QuadPart * 1000.0 / qf.QuadPart;
+			static double lastSubmitMs = 0;
+			if (lastSubmitMs > 0) {
+				const double d = ms - lastSubmitMs;
+				static const double edges[7] = { 8, 14, 16, 17.5, 20, 30, 50 };
+				int b = 7; for (int i = 0; i < 7; i++) if (d < edges[i]) { b = i; break; }
+				_bridgeHist[b]++;
+			}
+			lastSubmitMs = ms;
+			_bridgeLastSubmitMs = ms;
+		}
+		// New, unscaled frame: let the encoder have it in CUDA memory before Parsec asks for it.
+		if (offer && newFrameThisCall && frameToSubmit == _bridgeTexture && _bridgePixels)
+			offer(_bridgePixels, _bridgeW, _bridgeH, frameToSubmit);
+	}
+	ParsecStatus submitStatus = ParsecHostD3D11SubmitFrame(ps, 0, _device, _context, frameToSubmit);
+	{
+		LARGE_INTEGER workEnd, qf; QueryPerformanceCounter(&workEnd); QueryPerformanceFrequency(&qf);
+		const double ms = (workEnd.QuadPart - workStart.QuadPart) * 1000.0 / qf.QuadPart;
+		if (ms > _bridgeSlowest) _bridgeSlowest = ms;
+		static int slowLogs = 0;
+		if (ms > 25 && slowLogs++ < 10) SsbBridge::log("STALL: frame upload+submit took %.0f ms", ms);
+	}
+	static int submitLogs = 0;
+	if (submitLogs < 3) { submitLogs++; SsbBridge::log("video: ParsecHostD3D11SubmitFrame returned %d", (int)submitStatus); }
+	if (ensureLastSubmittedTexture(submitDesc.Width, submitDesc.Height, submitDesc.Format))
+		_context->CopyResource(_lastSubmittedTexture, frameToSubmit);
+
+	_mutex.unlock();
+	return true;
+}
+
 bool DX11::captureScreenDupl(ParsecDSO* ps)
 {
 	if (!_deskDupl)
@@ -840,6 +1069,7 @@
 
 bool DX11::isScalingEnabled()
 {
+	if (SsbBridge::linuxMode()) return false;   // the Linux helper scales (and the frame texture is a stand-in)
 	return _lanczosEnabled && _scalingInitialized && _targetWidth > 0 && _targetHeight > 0 && 
 	       (_targetWidth != (int)_desc.Width || _targetHeight != (int)_desc.Height);
 }
