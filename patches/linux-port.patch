+            // while hosting; redrawing it at 60 fps cost ~20% of the GPU).
+            // Full rate = the refresh rate of the monitor the window is on (re-read every 2 s, so dragging it to
+            // another screen follows); "ui_fps" in tuning.txt overrides it.
+            if (now - uiHzCheckMs > 2000.0) {
+                uiHzCheckMs = now;
+                int hz = 60;
+                if (HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST)) {
+                    MONITORINFOEXA mi = {}; mi.cbSize = sizeof(mi);
+                    DEVMODEA dm = {}; dm.dmSize = sizeof(dm);
+                    if (GetMonitorInfoA(mon, &mi) && EnumDisplaySettingsA(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) && dm.dmDisplayFrequency > 1)
+                        hz = (int)dm.dmDisplayFrequency;
+                }
+                uiMonitorHz = hz < 30 ? 30 : (hz > 480 ? 480 : hz);
+            }
+            const bool inUse = lastInputMs > 0 && now - lastInputMs < 1500.0;
+            const int uiFps = inUse ? SsbBridge::tuningInt("ui_fps", uiMonitorHz) : SsbBridge::tuningInt("ui_idle_fps", 15);
+            uiFrames++;
+            if (uiStatStart == 0) uiStatStart = now;
+            if (now - uiStatStart >= 5000) {
+                SsbBridge::log("ui: %.1f frames/s (limit %d)", uiFrames * 1000.0 / (now - uiStatStart), uiFps);
+                uiFrames = 0; uiStatStart = now;
+            }
+            if (uiFps > 0) {
+                const double interval = 1000.0 / uiFps;
+                if (uiNext == 0 || uiNext < now - 100) uiNext = now;   // fell far behind: restart the schedule
+                uiNext += interval;
+                for (double rem = uiNext - uiNowMs(); rem > 0; rem = uiNext - uiNowMs())
+                    Sleep(rem > 2.0 ? (DWORD)(rem - 1.0) : 1);
+            }
+        }
     }
 
